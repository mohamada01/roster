# ---- Website (Vercel > Project > Settings > Environment Variables) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...
# Starts fetching the moment a link is added (fine-grained token: this repo only, Actions: Read and write)
GITHUB_DISPATCH_TOKEN=github_pat_...
GITHUB_REPO=mohamada01/roster

# ---- Scraper (GitHub > repo > Settings > Secrets and variables > Actions) ----
# SUPABASE_URL          required
# SUPABASE_SECRET_KEY   required (sb_secret_...)
# YOUTUBE_API_KEY       optional, free
# GEMINI_API_KEY        optional, free
